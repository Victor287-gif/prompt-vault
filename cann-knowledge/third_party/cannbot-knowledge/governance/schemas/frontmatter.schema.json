{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {"type": "string", "minLength": 1},
    "title": {"type": "string"},
    "description": {"type": "string"},
    "tags": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "status": {"enum": ["draft", "stable", "deprecated"]},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource"],
        "properties": {
          "resource": {"type": "string", "minLength": 1},
          "role": {"enum": ["primary", "supporting", "example", "constraint", "header", "implementation", "evidence"]}
        }
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "platforms": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "verified": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["by", "at"],
          "properties": {
            "by": {"type": "string", "minLength": 1},
            "at": {"type": "string", "format": "date-time"}
          }
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["by", "at"],
            "properties": {
              "by": {"type": "string", "minLength": 1},
              "at": {"type": "string", "format": "date-time"}
            }
          }
        }
      ]
    },
    "cann_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "source_headers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "aliases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "source_technology": {"type": "string"},
    "target_technology": {"type": "string"},
    "replaced_by": {"type": "string", "minLength": 1}
  }
}
